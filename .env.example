# Copy this file to .env and fill in only what you use. Never commit .env.

# Which model to use: ollama (default, free, local) | anthropic | openai | mixed
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for MODEL_PROVIDER=anthropic, openai or mixed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
