+  // Determine if this is the alternatives field
+  const isAlternatives = fieldName === "alternatives";
+
+  // Determine if AI suggestion exists and is different from example placeholder
+  const hasAISuggestion =
+    aiSuggestion && aiSuggestion.trim() !== "" && aiSuggestion.trim() !== example?.trim();
+
+  // Text color styles for input value vs placeholder
+  const inputTextColorClass = value ? "text-gray-900" : "text-gray-500";
+
+  // Compose class for textarea
+  const textareaClass =
+    "w-full border border-gray-300 rounded p-2 text-sm " + inputTextColorClass;
+
+  return (
+    <div className="mb-4">
+      <label htmlFor={fieldName} className="block font-semibold mb-1">
+        {label}
+      </label>
+      <textarea
+        id={fieldName}
+        name={fieldName}
+        value={value}
+        placeholder={example}
+        onChange={onChange}
+        onKeyDown={handleKeyDown}
+        className={textareaClass}
+        rows={rows || 3}
+      />
+
+      {/* Layer B: Static field guidance as lower-priority helper text */}
+      {guidance && (
+        <div className="text-xs text-gray-500 mt-1">{guidance}</div>
+      )}
+
+      {/* For alternatives field, show empty state message and AI suggestion separated */}
+      {isAlternatives && !value && (
+        <>
+          <div className="text-xs text-gray-600 mt-1">No alternatives extracted yet.</div>
+          {hasAISuggestion && (
+            <div className="mt-1 rounded border border-gray-300 bg-gray-50 p-2 text-xs text-gray-700">
+              <div className="font-semibold mb-0.5">AI suggestion</div>
+              <div>{aiSuggestion}</div>
+            </div>
+          )}
+        </>
+      )}
+
+      {/* Layer C: Dynamic AI feedback */}
+      {!isAlternatives && aiFeedback && (
+        <div className="text-xs text-red-700 mt-1 font-semibold">{aiFeedback}</div>
+      )}
+
+      {/* Confidence and source notes below warning block */}
+      {confidence && (
+        <div className="text-xs text-gray-600 mt-1">{confidence}</div>
+      )}
+    </div>
+  );

